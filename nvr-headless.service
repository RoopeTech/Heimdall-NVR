[Unit]
Description=Antigravity IP Camera NVR & Viewer
After=network.target

[Service]
Type=simple
# Replace 'username' with the actual Linux user who owns the project folder
User=username
# Replace '/path/to/ip-camera-nvr' with the absolute path of the project folder
WorkingDirectory=/path/to/ip-camera-nvr
# Force headless mode to run uvicorn on the main thread
Environment=NVR_HEADLESS=1
ExecStart=/path/to/ip-camera-nvr/backend/venv/bin/python backend/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
